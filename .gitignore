# .gitignore audit and enhancement

# Original .gitignore
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/tasks.json

# Build output (correct)
build/
install/
scripts/download/

# Generated/runtime files
sqlite/
json/
*.log

# Test framework
gtest-download/*
!gtest-download/CMakeLists.txt.in

# Additional ignores for safety
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib

# Database files (runtime data)
*.db
*.sdb
*.sqlite
*.sql3

# Local configuration (may contain credentials)
config_local/**
!config_local/.gitignore

# IDE files
.vs/
*.user
*.suo
*.sln.docstates

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Kiro temporary files
.kiro/temp/
.kiro/cache/

# Backup files
*.bak
*.backup
*.old
*~

# Compressed archives (often contain binaries)
*.zip
*.tar.gz
*.7z
*.rar
